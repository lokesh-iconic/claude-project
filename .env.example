# Copy this file to .env and fill in values. .env is gitignored.
# Every module runs in mock mode (no API calls) when ANTHROPIC_API_KEY is empty,
# and switches to live mode automatically when a valid key is present.

# Anthropic API key (https://console.anthropic.com). Leave empty for mock mode.
ANTHROPIC_API_KEY=

# Optional: override the model used by the live-mode scripts.
# Defaults are pinned in code / config.yaml (claude-sonnet-4-6).
# The capstone model router ignores this so per-task routing stays intact.
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: module 2 (DocuQuery) generation settings; defaults come from config.yaml.
# CLAUDE_MAX_TOKENS=2048
# CLAUDE_TEMPERATURE=0.2
